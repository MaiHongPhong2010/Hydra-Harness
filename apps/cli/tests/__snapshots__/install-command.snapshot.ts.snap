exports[`reports failed installation and does not open the menu 1`] = `
{
  "code": 1,
  "output": "Installing hydra {{version}} with npm...",
  "stderr": "npm fixture: global prefix is not writable
hydra: npm global installation failed (exit 1). Check npm's error above and global-prefix permissions.",
}
`;
