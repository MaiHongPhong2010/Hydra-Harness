{
  "name": "@hydra1902/harness-web-frontend",
  "description": "Web application entry: vite build over the @hydra1902/harness-client-web shell library; dist/ served by apps/cli's hydra web",
  "version": "0.1.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "apps/web"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir"
  },
  "license": "MIT",
  "devDependencies": {
    "@hydra1902/harness-authorization": "workspace:^",
    "@hydra1902/harness-credentials": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-settings": "workspace:^",
    "@hydra1902/schemastery": "workspace:^",
    "@hydra1902/cordis-plugin-group": "workspace:^",
    "@hydra1902/harness-client-modules": "workspace:^",
    "@hydra1902/harness-client-ui-primitives": "workspace:^",
    "@hydra1902/harness-client-ui-slots": "workspace:^",
    "@hydra1902/harness-client-web": "workspace:^",
    "@hydra1902/harness-cmdline": "workspace:^",
    "@hydra1902/harness-pwsh-local": "workspace:^",
    "@types/node": "^26.4.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "playwright": "^1.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8",
    "fflate": "^0.8.2"
  }
}
