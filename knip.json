    },
    "apps/desktop": {
      "entry": [
        "preload.cjs"
      ],
      "ignoreBinaries": [
        "electron"
      ]
    },
    "packages/browser/browser-electron": {
      "entry": [
        "tests/**/*.spec.ts",
        "electron-app/preload.entry.js",
        "electron-app/playwright.cjs"
