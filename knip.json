    "packages/client/ui-suggested-prompts": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/host/optional-plugins": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/interaction/notifications": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/interaction/suggested-prompts": {
      "entry": [],
