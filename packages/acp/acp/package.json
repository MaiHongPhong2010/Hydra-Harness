{
  "name": "@hydraharness/harness-acp",
  "description": "Automation-only Agent Client Protocol server for driving Hydra harness agents over JSON-RPC stdio",
  "version": "0.1.1-rc.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@hydraharness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-agent-default-model": "workspace:^",
    "@hydraharness/harness-agent-presets": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-scope": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-user-approval": "workspace:^",
    "@hydraharness/harness-workspace-config": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-agent-default-model": "workspace:^",
    "@hydraharness/harness-agent-presets": "workspace:^",
    "@hydraharness/harness-agent-loop": "workspace:^",
    "@hydraharness/harness-agent-loop-testkit": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-scope": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-user-approval": "workspace:^",
    "@hydraharness/harness-workspace-config": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
