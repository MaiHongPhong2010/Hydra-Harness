{
  "name": "@hydraharness/harness-attachment-local",
  "description": "Private content-addressed HYDRA_HOME attachment storage",
  "hydra": {
    "plugin": {
      "application": "Store uploaded attachments privately so later turns can refer to the same files."
    }
  },
  "version": "0.1.1-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/attachment/attachment-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-home-paths": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-home-paths": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
