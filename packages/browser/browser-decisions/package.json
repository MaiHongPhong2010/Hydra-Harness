{
  "name": "@hydraharness/harness-browser-decisions",
  "description": "Optional model-facing browser decision tool backed by Jev",
  "hydra": {
    "plugin": {
      "application": "Ask Jev for optional browser action guidance when the browser_decide tool is enabled and configured."
    }
  },
  "version": "0.1.1-rc.8",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/browser/browser-decisions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-jev": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-jev": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
