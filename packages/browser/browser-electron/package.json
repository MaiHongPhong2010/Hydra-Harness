{
  "name": "@hydraharness/harness-browser-electron",
  "description": "Embedded browser seam for the Hydra harness — an owner-scoped Electron child process running the upstream PageAgent engine behind Hydra controls",
  "hydra": {
    "plugin": {
      "application": "Open browser tabs for an agent to inspect and interact with websites through browser tools."
    }
  },
  "version": "0.1.1-rc.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/browser/browser-electron"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "electron-app/autofill-vault.cjs",
    "electron-app/main.cjs",
    "electron-app/playwright.cjs",
    "electron-app/hydra.png",
    "electron-app/chrome.html",
    "electron-app/newtab.html",
    "electron-app/chrome-preload.cjs",
    "electron-app/preload.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build:preload": "vite build -c vite.preload.config.js"
  },
  "peerDependencies": {
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-home-paths": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-settings": "workspace:^",
    "@hydraharness/harness-user-approval": "workspace:^",
    "@hydraharness/harness-user-questions": "workspace:^",
    "@hydraharness/schemastery": "workspace:^",
    "electron": "^44.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-home-paths": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-settings": "workspace:^",
    "@hydraharness/harness-user-approval": "workspace:^",
    "@hydraharness/harness-user-questions": "workspace:^",
    "@hydraharness/schemastery": "workspace:^",
    "@hydraharness/harness-browseragent-core": "workspace:^",
    "@hydraharness/harness-browseragent-page-controller": "workspace:^",
    "electron": "^44.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "playwright-core": "1.61.1"
  }
}
