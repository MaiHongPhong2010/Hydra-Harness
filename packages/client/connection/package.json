{
  "name": "@hydraharness/harness-client-connection",
  "description": "Wire consumer layer: HTTP-up/WebSocket-down client, ConnectionController dual streams with reconnect, and fixture api",
  "version": "0.1.1-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/client/connection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "hydra": {
    "plugin": {
      "application": "Send interface actions to the Host and receive live updates, including after a reconnect."
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^",
    "ws": "^8.21.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@hydraharness/harness-host-webserver": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-host-apiproxy": "workspace:^",
    "@hydraharness/harness-commands": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-host-webserver": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@types/ws": "^8.18.1",
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-host-apiproxy": "workspace:^",
    "@hydraharness/harness-commands": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^"
  }
}
