{
  "name": "@hydraharness/harness-client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.1-rc.10",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "hydra": {
    "plugin": {
      "application": "Keep the interface's session and workspace state synchronized with Host updates."
    },
    "client": {
      "inject": [
        "@hydraharness/harness-client-connection",
        "@hydraharness/harness-typert-registry",
        "@hydraharness/harness-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "immer": "^11.1.18",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/harness-api-remotes": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-typert-protocol": "workspace:^",
    "@hydraharness/harness-typert-registry": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-client-connection": "workspace:^",
    "@hydraharness/harness-commands": "workspace:^",
    "@hydraharness/harness-host-apiproxy": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-llm-retry": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-session-projection": "workspace:^",
    "@hydraharness/harness-session-title": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/harness-api-remotes": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-timeout": "workspace:^",
    "@hydraharness/harness-typert-protocol": "workspace:^",
    "@hydraharness/harness-typert-registry": "workspace:^",
    "@types/react": "~18.3.1",
    "@hydraharness/harness-client-ui-slots": "workspace:^",
    "react": "^18.2.0",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-client-connection": "workspace:^",
    "@hydraharness/harness-commands": "workspace:^",
    "@hydraharness/harness-host-apiproxy": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-llm-retry": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-session-projection": "workspace:^",
    "@hydraharness/harness-session-title": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
