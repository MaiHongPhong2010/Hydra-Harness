{
  "name": "@hydraharness/harness-client-ui-reference",
  "description": "Unified Web @file and @session reference source",
  "version": "0.1.1-rc.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/client/ui-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "hydra": {
    "plugin": {
      "application": "Attach a workspace file or another session as context using @ references."
    },
    "client": {
      "inject": [
        "@hydraharness/harness-client-runtime",
        "@hydraharness/harness-api-remotes",
        "@hydraharness/harness-client-locale",
        "@hydraharness/harness-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-api-remotes": "workspace:^",
    "@hydraharness/harness-client-locale": "workspace:^",
    "@hydraharness/harness-client-runtime": "workspace:^",
    "@hydraharness/harness-client-ui-input-trigger": "workspace:^",
    "@hydraharness/harness-file-reference": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-session-reference": "workspace:^",
    "@hydraharness/harness-typert-protocol": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-api-remotes": "workspace:^",
    "@hydraharness/harness-client-locale": "workspace:^",
    "@hydraharness/harness-client-runtime": "workspace:^",
    "@hydraharness/harness-client-ui-input-trigger": "workspace:^",
    "@hydraharness/harness-client-ui-slots": "workspace:^",
    "@hydraharness/harness-file-reference": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-session-reference": "workspace:^",
    "@hydraharness/harness-typert-protocol": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
