{
  "name": "@hydraharness/harness-client-ui-suggested-prompts",
  "version": "0.1.1-rc.9",
  "description": "Bounded suggestions for empty chats",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/client/ui-suggested-prompts",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "type": "git"
  },
  "peerDependencies": {
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/harness-client-runtime": "workspace:^",
    "@hydraharness/harness-client-locale": "workspace:^",
    "@hydraharness/harness-client-ui-settings": "workspace:^",
    "@hydraharness/harness-client-ui-conversation": "workspace:^",
    "@hydraharness/harness-api-remotes": "workspace:^",
    "@hydraharness/harness-suggested-prompts": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/harness-client-runtime": "workspace:^",
    "@hydraharness/harness-client-locale": "workspace:^",
    "@hydraharness/harness-client-ui-settings": "workspace:^",
    "@hydraharness/harness-client-ui-conversation": "workspace:^",
    "@hydraharness/harness-client-ui-primitives": "workspace:^",
    "@hydraharness/harness-client-ui-slots": "workspace:^",
    "@hydraharness/harness-api-remotes": "workspace:^",
    "@hydraharness/harness-suggested-prompts": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@hydraharness/harness-invariants": "workspace:^"
  },
  "hydra": {
    "plugin": {
      "application": "Suggest bounded draft prompts from readable project context."
    },
    "client": {
      "inject": [
        "@hydraharness/harness-client-runtime",
        "@hydraharness/harness-client-locale",
        "@hydraharness/harness-client-ui-settings",
        "@hydraharness/harness-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
