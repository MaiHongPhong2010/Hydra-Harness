{
  "name": "@hydraharness/harness-credentials-local",
  "description": "File-backed credentials provider ($HYDRA_HOME/.env under the live process environment) for the Hydra harness",
  "hydra": {
    "plugin": {
      "application": "Resolve provider credentials from the process environment and the Hydra home credential file."
    }
  },
  "version": "0.1.1-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-atomic-write": "workspace:^",
    "@hydraharness/harness-credentials": "workspace:^",
    "@hydraharness/harness-launch-environment": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-home-paths": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "@hydraharness/schemastery": "workspace:^",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@hydraharness/harness-atomic-write": "workspace:^",
    "@hydraharness/harness-credentials": "workspace:^",
    "@hydraharness/harness-launch-environment": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-home-paths": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
