{
  "name": "@hydraharness/harness-command-feedback",
  "description": "Log-only session feedback producer and human-facing slash command",
  "hydra": {
    "plugin": {
      "application": "Record session feedback through a slash command."
    }
  },
  "version": "0.1.1-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/feedback/command-feedback"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-commands": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-session-telemetry": "workspace:^",
    "@hydraharness/harness-anonymous-user-id": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/cordis-plugin-include": "workspace:^",
    "@hydraharness/cordis-plugin-loader": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-commands": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-session-telemetry": "workspace:^",
    "@hydraharness/harness-anonymous-user-id": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
