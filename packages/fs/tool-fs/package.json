{
  "name": "@hydraharness/harness-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the Hydra harness filesystem seam (ctx.fs)",
  "hydra": {
    "plugin": {
      "application": "Let the agent read, write, and edit workspace files."
    }
  },
  "version": "0.1.1-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@hydraharness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-fs": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-sandbox": "workspace:^",
    "@hydraharness/harness-sandbox-policy": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-user-approval": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-fs": "workspace:^",
    "@hydraharness/harness-fs-local": "workspace:^",
    "@hydraharness/harness-fs-observation-policy": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-sandbox": "workspace:^",
    "@hydraharness/harness-sandbox-policy": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-user-approval": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
