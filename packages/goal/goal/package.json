{
  "name": "@hydraharness/harness-goal",
  "description": "Event-sourced same-session goal state and lifecycle service for the Hydra harness",
  "hydra": {
    "plugin": {
      "application": "Persist a session goal and its status so work can continue toward the same objective."
    }
  },
  "version": "0.1.1-rc.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/goal/goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-session-projection": "workspace:^",
    "@hydraharness/harness-brand": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-scope": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-typert-protocol": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-session-projection": "workspace:^",
    "@hydraharness/harness-brand": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-loader-smoke": "workspace:^",
    "@hydraharness/harness-scope": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-typert-protocol": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
