{
  "name": "@hydraharness/harness-hooks-codex",
  "description": "Bridge plugin: run a Codex hooks.json hook config on the Hydra harness interception seams",
  "version": "0.1.1-rc.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/hooks/hooks-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./config": {
      "types": "./lib/types/config.d.ts",
      "default": "./lib/types/config.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@hydraharness/harness-optional-plugins": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-hook-protocol": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-session-persistence": "workspace:^",
    "@hydraharness/harness-subagent": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-optional-plugins": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-agent-loop": "workspace:^",
    "@hydraharness/harness-agent-loop-testkit": "workspace:^",
    "@hydraharness/harness-shell": "workspace:^",
    "@hydraharness/harness-bash-local": "workspace:^",
    "@hydraharness/harness-subprocess-local": "workspace:^",
    "@hydraharness/harness-hook-protocol": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-session-persistence": "workspace:^",
    "@hydraharness/harness-session-persistence-jsonl": "workspace:^",
    "@hydraharness/harness-subagent": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
