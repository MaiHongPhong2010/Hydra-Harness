{
  "name": "@hydraharness/harness-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "hydra": {
    "plugin": {
      "application": "Connect the app to Host-owned conversations, uploads, and local file operations."
    }
  },
  "version": "0.1.1-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hydraharness/harness-agent-instructions": "workspace:^",
    "@hydraharness/harness-atomic-write": "workspace:^",
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-agent-default-model": "workspace:^",
    "@hydraharness/harness-authorization": "workspace:^",
    "@hydraharness/harness-api-remotes": "workspace:^",
    "@hydraharness/harness-brand": "workspace:^",
    "@hydraharness/harness-commands": "workspace:^",
    "@hydraharness/harness-credentials": "workspace:^",
    "@hydraharness/harness-home-paths": "workspace:^",
    "@hydraharness/harness-goal": "workspace:^",
    "@hydraharness/harness-host-directory-picker": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-native-command": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-session-persistence": "workspace:^",
    "@hydraharness/harness-session-projection": "workspace:^",
    "@hydraharness/harness-session-projection-cache": "workspace:^",
    "@hydraharness/harness-session-query": "workspace:^",
    "@hydraharness/harness-session-title": "workspace:^",
    "@hydraharness/harness-settings": "workspace:^",
    "@hydraharness/harness-skill": "workspace:^",
    "@hydraharness/harness-subagent": "workspace:^",
    "@hydraharness/harness-jobs": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-user-approval": "workspace:^",
    "@hydraharness/harness-user-questions": "workspace:^",
    "@hydraharness/harness-workspace": "workspace:^",
    "@hydraharness/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3",
    "@hydraharness/harness-web": "workspace:^"
  },
  "peerDependencies": {
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/harness-agent-presets": "workspace:^",
    "@hydraharness/harness-cordis-host-runner": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-permission-presets": "workspace:^",
    "@hydraharness/harness-fs-review": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/harness-agent-presets": "workspace:^",
    "@hydraharness/harness-cordis-host-runner": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-permission-presets": "workspace:^",
    "@hydraharness/harness-storage": "workspace:^",
    "@hydraharness/harness-storage-domain": "workspace:^",
    "@hydraharness/harness-typert-protocol": "workspace:^",
    "@hydraharness/harness-typert-registry": "workspace:^",
    "@hydraharness/harness-fs-review": "workspace:^"
  }
}
