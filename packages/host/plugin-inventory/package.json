{
  "name": "@hydraharness/harness-host-plugin-inventory",
  "description": "Remote projection and shared-settings controls for current Cordis Loader plugin state",
  "hydra": {
    "plugin": {
      "application": "Expose installed plugin information and persist plugin, marketplace, MCP, and hook settings."
    }
  },
  "version": "0.1.1-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/host/plugin-inventory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@hydraharness/harness-app-boot": "workspace:^",
    "@hydraharness/harness-atomic-write": "workspace:^",
    "@hydraharness/harness-brand": "workspace:^",
    "@hydraharness/harness-hooks-registry": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-mcp-registry": "workspace:^",
    "@hydraharness/harness-plugin-runtime": "workspace:^",
    "@hydraharness/harness-settings": "workspace:^",
    "@hydraharness/harness-typert-protocol": "workspace:^",
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/cordis-plugin-include": "workspace:^",
    "@hydraharness/cordis-plugin-loader": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-app-boot": "workspace:^",
    "@hydraharness/harness-atomic-write": "workspace:^",
    "@hydraharness/harness-brand": "workspace:^",
    "@hydraharness/harness-hooks-registry": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-mcp-registry": "workspace:^",
    "@hydraharness/harness-plugin-runtime": "workspace:^",
    "@hydraharness/harness-settings": "workspace:^",
    "@hydraharness/harness-settings-file": "workspace:^",
    "@hydraharness/harness-typert-protocol": "workspace:^",
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/cordis-plugin-include": "workspace:^",
    "@hydraharness/cordis-plugin-loader": "workspace:^"
  }
}
