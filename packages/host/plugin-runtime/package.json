{
  "name": "@hydraharness/harness-plugin-runtime",
  "description": "Shared immutable OpenAI/Codex-compatible imported plugin runtime for the Hydra harness",
  "hydra": {
    "plugin": {
      "application": "Import compatible plugin bundles and activate their skills, commands, MCP servers, and trusted hooks."
    }
  },
  "version": "0.1.1-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/host/plugin-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-atomic-write": "workspace:^",
    "@hydraharness/harness-commands": "workspace:^",
    "@hydraharness/harness-hook-protocol": "workspace:^",
    "@hydraharness/harness-hooks-codex": "workspace:^",
    "@hydraharness/harness-home-paths": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-mcp-client": "workspace:^",
    "@hydraharness/harness-skill": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@hydraharness/harness-atomic-write": "workspace:^",
    "@hydraharness/harness-commands": "workspace:^",
    "@hydraharness/harness-hook-protocol": "workspace:^",
    "@hydraharness/harness-hooks-codex": "workspace:^",
    "@hydraharness/harness-home-paths": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-mcp-client": "workspace:^",
    "@hydraharness/harness-skill": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
