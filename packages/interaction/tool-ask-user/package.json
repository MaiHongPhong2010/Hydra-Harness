{
  "name": "@hydraharness/harness-tool-ask-user",
  "description": "Model-facing ask_user_question tool over the ctx.userQuestions seam",
  "hydra": {
    "plugin": {
      "application": "Let the agent ask structured questions and wait for the user's answers."
    }
  },
  "version": "0.1.1-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/interaction/tool-ask-user"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-user-questions": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-user-questions": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
