{
  "name": "@hydraharness/harness-user-approval",
  "description": "User-approval seam (ctx.approval) for the Hydra harness: one-shot permission decisions dispatched to composed answerers over the approval/request waterfall, fail-closed by default",
  "hydra": {
    "plugin": {
      "application": "Request a user decision before performing operations that require approval."
    }
  },
  "version": "0.1.1-rc.10",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/interaction/user-approval"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-brand": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-scope": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-brand": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-scope": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
