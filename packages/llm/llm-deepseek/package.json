{
  "name": "@hydraharness/harness-llm-deepseek",
  "description": "DeepSeek chat-completions adapter for the Hydra harness LLM seam",
  "hydra": {
    "plugin": {
      "application": "Send model requests to the configured DeepSeek chat-completions endpoint."
    }
  },
  "version": "0.1.1-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/llm/llm-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-credentials": "workspace:^",
    "@hydraharness/harness-launch-environment": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-settings": "workspace:^",
    "@hydraharness/harness-timeout": "workspace:^",
    "@hydraharness/harness-anonymous-user-id": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "eventsource-parser": "^3.1.0",
    "@hydraharness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-credentials": "workspace:^",
    "@hydraharness/harness-launch-environment": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-settings": "workspace:^",
    "@hydraharness/harness-timeout": "workspace:^",
    "@hydraharness/harness-anonymous-user-id": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
