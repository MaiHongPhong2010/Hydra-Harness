{
  "name": "@hydraharness/harness-persona",
  "description": "Composition-authored deployment persona section for the Hydra harness",
  "hydra": {
    "plugin": {
      "application": "Give agents the persona instructions declared by their preset."
    }
  },
  "version": "0.1.1-rc.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/preset/persona"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-scope": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
