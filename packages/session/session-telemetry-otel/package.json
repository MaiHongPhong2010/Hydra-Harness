{
  "name": "@hydraharness/harness-session-telemetry-otel",
  "description": "OpenTelemetry backend for the Hydra harness telemetry seam: hands captured session records to the OTel JS SDK's log pipeline",
  "hydra": {
    "plugin": {
      "application": "Send captured session telemetry to the configured OpenTelemetry reporting backend."
    }
  },
  "version": "0.1.1-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/session/session-telemetry-otel"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/otlp-exporter-base": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@hydraharness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@hydraharness/harness-command-feedback": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-session-telemetry": "workspace:^",
    "@hydraharness/harness-anonymous-user-id": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/cordis-plugin-loader": "workspace:^",
    "@hydraharness/harness-command-feedback": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-session-telemetry": "workspace:^",
    "@hydraharness/harness-anonymous-user-id": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
