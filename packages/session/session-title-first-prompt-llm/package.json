{
  "name": "@hydraharness/harness-session-title-first-prompt-llm",
  "description": "First-message LLM provider plugin for Hydra harness session titles",
  "hydra": {
    "plugin": {
      "application": "Generate a conversation title from its first user prompt with the configured model."
    }
  },
  "version": "0.1.1-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/session/session-title-first-prompt-llm"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-session-title": "workspace:^",
    "@hydraharness/harness-session-title-llm": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/cordis-plugin-include": "workspace:^",
    "@hydraharness/cordis-plugin-loader": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-session-title": "workspace:^",
    "@hydraharness/harness-session-title-llm": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
