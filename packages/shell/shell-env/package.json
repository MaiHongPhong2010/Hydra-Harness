{
  "name": "@hydraharness/harness-shell-env",
  "description": "Tool-independent managed HYDRA_* shell environment registry",
  "hydra": {
    "plugin": {
      "application": "Expose managed Hydra environment variables to shell commands."
    }
  },
  "version": "0.1.1-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/shell/shell-env"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-shell": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-home-paths": "workspace:^",
    "@hydraharness/harness-session-persistence": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-shell": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-home-paths": "workspace:^",
    "@hydraharness/harness-session-persistence": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
