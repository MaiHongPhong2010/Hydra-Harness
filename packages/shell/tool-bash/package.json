{
  "name": "@hydraharness/harness-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "hydra": {
    "plugin": {
      "application": "Let the agent run Bash commands and collect their output."
    }
  },
  "version": "0.1.1-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-shell": "workspace:^",
    "@hydraharness/harness-shell-env": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-sandbox": "workspace:^",
    "@hydraharness/harness-sandbox-policy": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/harness-jobs": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-user-approval": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-agent-loop": "workspace:^",
    "@hydraharness/harness-agent-loop-testkit": "workspace:^",
    "@hydraharness/harness-shell": "workspace:^",
    "@hydraharness/harness-shell-env": "workspace:^",
    "@hydraharness/harness-bash-local": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-subprocess-local": "workspace:^",
    "@hydraharness/harness-sandbox": "workspace:^",
    "@hydraharness/harness-sandbox-policy": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-session-persistence-jsonl": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/harness-jobs": "workspace:^",
    "@hydraharness/harness-jobs-local": "workspace:^",
    "@hydraharness/harness-tool-jobs": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-user-approval": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
