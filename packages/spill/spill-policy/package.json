{
  "name": "@hydraharness/harness-spill-policy",
  "description": "Tool-result spill policy for the Hydra harness — replaces oversized plain-text tool results with a retained preview plus a spill-file path (no service API)",
  "hydra": {
    "plugin": {
      "application": "Replace oversized tool output with a preview and a path to the retained full content."
    }
  },
  "version": "0.1.1-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-output-retention": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-spill": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-code-runtime-worker-thread": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-output-retention": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-spill": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
