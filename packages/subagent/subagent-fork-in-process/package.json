{
  "name": "@hydraharness/harness-subagent-fork-in-process",
  "description": "In-process fork subagent backend: runs a child agent seeded with a prefix of the parent's log",
  "hydra": {
    "plugin": {
      "application": "Start a child agent with a copy of the parent conversation up to the fork point."
    }
  },
  "version": "0.1.1-rc.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/subagent/subagent-fork-in-process"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-subagent": "workspace:^",
    "@hydraharness/harness-subagent-in-process-driver": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/cordis-plugin-loader": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-agent-loop": "workspace:^",
    "@hydraharness/harness-agent-loop-testkit": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-subagent": "workspace:^",
    "@hydraharness/harness-subagent-in-process-driver": "workspace:^",
    "@hydraharness/harness-subagent-spawn-in-process": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
