{
  "name": "@hydraharness/harness-subagent-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Hydra harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.1-rc.10",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/subagent/subagent-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-sdk-client": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-subagent": "workspace:^",
    "@hydraharness/harness-subprocess": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/cordis-plugin-loader": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-loader-smoke": "workspace:^",
    "@hydraharness/harness-sdk-client": "workspace:^",
    "@hydraharness/harness-sdk-protocol": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-subagent": "workspace:^",
    "@hydraharness/harness-subprocess": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
