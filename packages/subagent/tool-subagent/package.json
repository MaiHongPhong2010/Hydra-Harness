{
  "name": "@hydraharness/harness-tool-subagent",
  "description": "Model-facing subagent delegation tool over the ctx.subagents seam",
  "hydra": {
    "plugin": {
      "application": "Let the agent delegate a task to a child agent."
    }
  },
  "version": "0.1.1-rc.10",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/subagent/tool-subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-subagent": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/harness-jobs": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydraharness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/cordis-plugin-loader": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-session-persistence": "workspace:^",
    "@hydraharness/harness-session-persistence-jsonl": "workspace:^",
    "@hydraharness/harness-subagent": "workspace:^",
    "@hydraharness/harness-subagent-spawn-in-process": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/harness-jobs": "workspace:^",
    "@hydraharness/harness-jobs-local": "workspace:^",
    "@hydraharness/harness-tool-jobs": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
