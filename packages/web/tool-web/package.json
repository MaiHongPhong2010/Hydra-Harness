{
  "name": "@hydraharness/harness-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Hydra harness web capability seam (ctx.web)",
  "hydra": {
    "plugin": {
      "application": "Let the agent search the web and fetch pages through configured web providers."
    }
  },
  "version": "0.1.1-rc.10",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-web": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@hydraharness/schemastery": "workspace:^",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@hydraharness/harness-agent": "workspace:^",
    "@types/turndown": "^5.0.6",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-spill-local": "workspace:^",
    "@hydraharness/harness-spill-policy": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/harness-tool-call-timeout-policy": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-web": "workspace:^",
    "@hydraharness/harness-web-fetch-http": "workspace:^",
    "@hydraharness/harness-web-search-exa": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
