{
  "name": "@hydraharness/harness-web-fetch-http",
  "description": "Anonymous public HTTP(S) fetch provider for the Hydra harness web capability seam (ctx.web)",
  "hydra": {
    "plugin": {
      "application": "Retrieve publicly accessible HTTP or HTTPS pages without account credentials."
    }
  },
  "version": "0.1.1-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/web/web-fetch-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-timeout": "workspace:^",
    "@hydraharness/harness-web": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "undici": "^7.28.0",
    "@hydraharness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-timeout": "workspace:^",
    "@hydraharness/harness-web": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
