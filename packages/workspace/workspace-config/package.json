{
  "name": "@hydraharness/harness-workspace-config",
  "description": "Workspace-local settings, trust, and scoped runtime composition for the Hydra harness",
  "hydra": { "plugin": { "application": "Keep settings, MCP servers, hooks, and presets separate for each workspace." } },
  "version": "0.1.1-rc.10",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/MaiHongPhong2010/Hydra-Harness.git", "directory": "packages/workspace/workspace-config" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/harness-settings": "workspace:^",
    "@hydraharness/harness-settings-file": "workspace:^",
    "@hydraharness/harness-workspace": "workspace:^",
    "@hydraharness/harness-scope": "workspace:^",
    "@hydraharness/harness-agent-presets": "workspace:^",
    "@hydraharness/harness-mcp-registry": "workspace:^",
    "@hydraharness/harness-hooks-registry": "workspace:^",
    "@hydraharness/harness-home-paths": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-shell": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^"
  },
  "dependencies": { "@hydraharness/schemastery": "workspace:^" },
  "devDependencies": {
    "@hydraharness/cordis": "workspace:^",
    "@hydraharness/harness-settings": "workspace:^",
    "@hydraharness/harness-settings-file": "workspace:^",
    "@hydraharness/harness-workspace": "workspace:^",
    "@hydraharness/harness-scope": "workspace:^",
    "@hydraharness/harness-agent-presets": "workspace:^",
    "@hydraharness/harness-mcp-registry": "workspace:^",
    "@hydraharness/harness-hooks-registry": "workspace:^",
    "@hydraharness/harness-home-paths": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-tools": "workspace:^",
    "@hydraharness/harness-shell": "workspace:^",
    "@hydraharness/harness-system-prompt": "workspace:^",
    "@hydraharness/harness-agent": "workspace:^",
    "@hydraharness/cordis-plugin-loader": "workspace:^",
    "@hydraharness/cordis-plugin-include": "workspace:^",
    "@hydraharness/harness-storage": "workspace:^",
    "@hydraharness/harness-storage-domain": "workspace:^",
    "@hydraharness/harness-agent-default-model": "workspace:^",
    "@hydraharness/harness-agent-loop": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^"
  }
}
